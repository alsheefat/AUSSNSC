ENV=development                      # set to "production" on the server
SECRET_KEY=change-me-to-a-long-random-string   # python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=sqlite:///./aussnsc.db  # or postgresql://user:pass@host/dbname
CORS_ORIGINS=*
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# First admin account (created on first start if no admin exists)
ADMIN_NAME=School Admin
ADMIN_PHONE=01700000000
ADMIN_EMAIL=
ADMIN_PASSWORD=ChangeThisNow123

# Demo data (dev only): sample classes, notices, student/teacher/parent logins
SEED_DEMO=1

# Optional integrations
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
FIREBASE_CREDENTIALS=                # path to Firebase service-account JSON for push
TRUST_PROXY=0                        # 1 if behind nginx/Render/etc. (uses X-Forwarded-For)

# Firebase (Google sign-in): your Firebase project ID (Project settings > General)
FIREBASE_PROJECT_ID=
ENABLE_DOCS=1                        # serves /docs (Swagger UI) so the admin can manage data; admin routes still need a token
